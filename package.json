{
  "name": "onshive-web",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "온스하이브 기업 소개 웹사이트",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src vite.config.ts tsconfig.json package.json",
    "test": "npm run build && node scripts/verify-site.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0"
  }
}
